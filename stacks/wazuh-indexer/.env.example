# Wazuh indexer stack. Copy to .env next to deploy.sh and edit.

# Name of this instance: directory /stacks/<STACK_NAME>, container name,
# Compose project and the indexer's node name (certificate CN). Lowercase
# letters, digits and "-", starts with a letter, at most 32 characters.
STACK_NAME=wdl01

# Image tag of wazuh/wazuh-indexer.
WAZUH_VERSION=4.14.1

# JVM heap (-Xms and -Xmx), e.g. 8g or 4096m. Empty: half of the host's
# RAM, at most 31g (the rest stays free for the file system cache).
INDEXER_HEAP=

# Where the REST API (9200) is published on the host. Reachable from every
# network that reaches the VM: see docs/wazuh-indexer.md to restrict it.
INDEXER_BIND=0.0.0.0
INDEXER_PORT=9200

# Extra names / IPv4 addresses for the indexer certificate, comma
# separated. The instance name, the host's names, its IPv4 addresses,
# localhost and 127.0.0.1 are always included.
CERT_SAN=
